# ── Supabase ─────────────────────────────────────────────────────────────────
# REQUIRED. Local values come from `npx supabase status`.
# Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED, SERVER ONLY. Never expose to the browser. Used for POD uploads,
# signed URLs and PDF caching — the three paths that must bypass RLS after
# doing their own authorisation.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts/ and migration smoke tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── App ──────────────────────────────────────────────────────────────────────
# REQUIRED. Absolute origin. Embedded in LR QR codes and WhatsApp deep links,
# so a wrong value ships broken tracking URLs onto printed paper.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Local development only ───────────────────────────────────────────────────
# Set DEV_AUTO_LOGIN=1 to bypass the login screen while working locally: the
# proxy signs in as the account below on the first unauthenticated request.
#
# This is ignored entirely when NODE_ENV=production, so it cannot be enabled on
# a deployed environment even by mistake. Leave it unset unless you want it.
DEV_AUTO_LOGIN=
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=
